<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftModLauncher.ViewModels"
             xmlns:modrinth="using:MinecraftModLauncher.Models.Modrinth"
             xmlns:models="using:MinecraftModLauncher.Models"
             xmlns:converters="using:MinecraftModLauncher.Converters"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             x:Class="MinecraftModLauncher.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

	<Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,*" RowSpacing="20">

		<!-- Header: title + minimized "which instance am I installing to" menu -->
		<Border Grid.Row="0" Classes="card">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="Library" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

				<Button x:Name="TargetInstanceButton" Grid.Column="1" VerticalAlignment="Center">
					<Button.Flyout>
						<Flyout Placement="BottomEdgeAlignedRight">
							<StackPanel Classes="flyout-content" Spacing="4" MinWidth="200">
								<TextBlock Text="INSTALL TO" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
								<ItemsControl ItemsSource="{Binding Main.Instances}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="models:Instance">
											<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).Main.SelectInstanceCommand}"
                                                    CommandParameter="{Binding}">
												<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="No instances yet — create one from Home" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsVisible="{Binding Main.Instances.Count, Converter={x:Static converters:IsZeroConverter.Instance}}" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
					<StackPanel Orientation="Horizontal" Spacing="6">
						<TextBlock Text="Installing to:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
						<TextBlock Text="{Binding Main.SelectedInstance.Name, FallbackValue='None selected', TargetNullValue='None selected'}"
                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
						<TextBlock Text="▾" VerticalAlignment="Center" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- Connected box: search + filter bar + results, fills remaining height -->
		<Border Grid.Row="1" Classes="card" Padding="0">
			<Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

				<!-- Search row -->
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,18">
					<TextBox Grid.Column="0" Text="{Binding Main.ModrinthSearch.SearchQuery}"
                             Watermark="Search Modrinth..." Margin="0,0,10,0" />
					<Button Grid.Column="1" Content="Search" Classes="accent"
                            Command="{Binding Main.ModrinthSearch.SearchCommand}" />
				</Grid>

				<Border Grid.Row="1" Height="1" Background="{StaticResource Surface1Brush}" />

				<!-- Sort/filter bar -->
				<Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="20,12">

					<Button x:Name="TypeButton" Grid.Column="0" Content="{Binding Main.ModrinthSearch.SelectedProjectType, StringFormat='Type: {0} ▾'}">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<StackPanel Classes="flyout-content" Spacing="4" MinWidth="160">
									<TextBlock Text="PROJECT TYPE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
									<ItemsControl ItemsSource="{Binding Main.ModrinthSearch.ProjectTypes}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="x:String">
												<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{Binding}"
                                                        Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).Main.ModrinthSearch.SetProjectTypeCommand}"
                                                        CommandParameter="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button x:Name="LoaderButton" Grid.Column="1" Content="{Binding Main.ModrinthSearch.SelectedLoader, StringFormat='Loader: {0} ▾', FallbackValue='Loader: Any ▾', TargetNullValue='Loader: Any ▾'}">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<StackPanel Classes="flyout-content" Spacing="4" MinWidth="160">
									<TextBlock Text="LOADER" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
									<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Content="Any"
                                            Command="{Binding Main.ModrinthSearch.SetLoaderCommand}"
                                            CommandParameter="{x:Null}" />
									<ItemsControl ItemsSource="{Binding Main.ModrinthSearch.AvailableLoaders}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="x:String">
												<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Content="{Binding}"
                                                        Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).Main.ModrinthSearch.SetLoaderCommand}"
                                                        CommandParameter="{Binding}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button x:Name="LibraryCategoryButton" Grid.Column="2" Content="Category ▾">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<StackPanel Classes="flyout-content" Spacing="6" MinWidth="200">
									<TextBlock Text="FILTER BY CATEGORY" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
									<ItemsControl ItemsSource="{Binding Main.ModrinthSearch.CategoryFilterOptions}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:FilterOptionViewModel">
												<CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="No categories for this type" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsVisible="{Binding Main.ModrinthSearch.CategoryFilterOptions.Count, Converter={x:Static converters:IsZeroConverter.Instance}}" />
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<Button x:Name="SortButton" Grid.Column="3" Content="Sort ▾">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<StackPanel Classes="flyout-content" Spacing="4" MinWidth="150">
									<TextBlock Text="SORT BY" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
									<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Relevance"
                                            Command="{Binding Main.ModrinthSearch.SetSortIndexCommand}" CommandParameter="relevance" />
									<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Downloads"
                                            Command="{Binding Main.ModrinthSearch.SetSortIndexCommand}" CommandParameter="downloads" />
									<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Newest"
                                            Command="{Binding Main.ModrinthSearch.SetSortIndexCommand}" CommandParameter="newest" />
									<Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="Recently updated"
                                            Command="{Binding Main.ModrinthSearch.SetSortIndexCommand}" CommandParameter="updated" />
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<TextBlock Grid.Column="6" Text="{Binding Main.ModrinthSearch.StatusMessage}"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" />
				</Grid>

				<Border Grid.Row="3" Height="1" Background="{StaticResource Surface1Brush}" />

				<!-- Darker recessed area holding results, flush with the box below -->
				<Border Grid.Row="4" Background="{StaticResource MantleBrush}"
                        CornerRadius="0,0,10,10"
                        Padding="20">
					<Panel>

						<!-- Search results -->
						<ListBox Classes="card-gallery"
                                 ItemsSource="{Binding Main.ModrinthSearch.Results}">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="modrinth:ModrinthSearchHit">
									<StackPanel Width="200" Spacing="10" HorizontalAlignment="Center">
										<asyncImageLoader:AdvancedImage
                                            Source="{Binding IconUrl}"
                                            Width="64" Height="64"
                                            HorizontalAlignment="Center" />

										<TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

										<TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12" MaxLines="2" TextAlignment="Center" />

										<StackPanel HorizontalAlignment="Center" Spacing="4">
											<Border Classes="chip" HorizontalAlignment="Center">
												<TextBlock Text="{Binding Categories, Converter={x:Static converters:CategoriesSummaryConverter.Instance}}" />
											</Border>
											<Border Classes="chip" HorizontalAlignment="Center">
												<TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}" />
											</Border>
											<Border Classes="chip" HorizontalAlignment="Center">
												<TextBlock Text="{Binding Author}" />
											</Border>
										</StackPanel>

										<Button HorizontalAlignment="Center" Content="+ Install"
                                                Command="{Binding $parent[ListBox].((vm:LibraryViewModel)DataContext).Main.ModrinthSearch.InstallCommand}"
                                                CommandParameter="{Binding}">
											<Button.IsVisible>
												<MultiBinding Converter="{x:Static converters:IsProjectInstalledConverter.Instance}" ConverterParameter="invert">
													<Binding Path="ProjectId" />
													<Binding Path="$parent[ListBox].((vm:LibraryViewModel)DataContext).Main.InstanceMods" />
													<Binding Path="$parent[ListBox].((vm:LibraryViewModel)DataContext).Main.InstanceMods.Count" />
												</MultiBinding>
											</Button.IsVisible>
										</Button>

										<Border Classes="chip" HorizontalAlignment="Center"
                                                Background="{StaticResource AccentGreenBrush}">
											<Border.IsVisible>
												<MultiBinding Converter="{x:Static converters:IsProjectInstalledConverter.Instance}">
													<Binding Path="ProjectId" />
													<Binding Path="$parent[ListBox].((vm:LibraryViewModel)DataContext).Main.InstanceMods" />
													<Binding Path="$parent[ListBox].((vm:LibraryViewModel)DataContext).Main.InstanceMods.Count" />
												</MultiBinding>
											</Border.IsVisible>
											<TextBlock Text="✓ Installed" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CrustBrush}" />
										</Border>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<TextBlock Text="No results — try a different search or filter" FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Main.ModrinthSearch.Results.Count, Converter={x:Static converters:IsZeroConverter.Instance}}" />
					</Panel>
				</Border>
			</Grid>
		</Border>
	</Grid>
</UserControl>
