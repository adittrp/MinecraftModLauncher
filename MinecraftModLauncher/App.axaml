<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinecraftModLauncher.App"
             xmlns:local="using:MinecraftModLauncher"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

	<Application.Resources>
		<!-- Base surfaces (darkest to lightest) -->
		<Color x:Key="Crust">#11111B</Color>
		<Color x:Key="Mantle">#181825</Color>
		<Color x:Key="Base">#1E1E2E</Color>
		<Color x:Key="Surface0">#313244</Color>
		<Color x:Key="Surface1">#45475A</Color>
		<Color x:Key="Surface2">#585B70</Color>

		<!-- Text hierarchy -->
		<Color x:Key="TextPrimary">#CDD6F4</Color>
		<Color x:Key="TextSecondary">#A6ADC8</Color>
		<Color x:Key="TextMuted">#6C7086</Color>

		<!-- Accents -->
		<Color x:Key="AccentGreen">#A6E3A1</Color>
		<Color x:Key="AccentBlue">#89B4FA</Color>
		<Color x:Key="AccentMauve">#CBA6F7</Color>
		<Color x:Key="AccentRed">#F38BA8</Color>
		<Color x:Key="AccentYellow">#F9E2AF</Color>
		<Color x:Key="AccentPeach">#FAB387</Color>

		<!-- Brush versions (for Background, Foreground, BorderBrush) -->
		<SolidColorBrush x:Key="CrustBrush" Color="{StaticResource Crust}" />
		<SolidColorBrush x:Key="MantleBrush" Color="{StaticResource Mantle}" />
		<SolidColorBrush x:Key="BaseBrush" Color="{StaticResource Base}" />
		<SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0}" />
		<SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1}" />
		<SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2}" />

		<SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
		<SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
		<SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />

		<SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />
		<SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}" />
		<SolidColorBrush x:Key="AccentMauveBrush" Color="{StaticResource AccentMauve}" />
		<SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />

		<!-- Shared sizing -->
		<CornerRadius x:Key="CardRadius">10</CornerRadius>
		<CornerRadius x:Key="ChipRadius">6</CornerRadius>
		<Thickness x:Key="PageMargin">30</Thickness>
		<Thickness x:Key="CardPadding">20</Thickness>
		<Thickness x:Key="ChipPadding">8,3</Thickness>
	</Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Shared "card" surface: base look for any grouped content block.
             Add Classes="card" to a Border to opt in; ".compact" trims padding
             for list rows. Defined once so new pages/lists stay visually consistent. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        </Style>
        <Style Selector="Border.card.compact">
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.card.interactive:pointerover">
            <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        </Style>

        <!-- Shared pill/badge for short metadata (version, loader, project type, counts). -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
            <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
            <Setter Property="Padding" Value="{StaticResource ChipPadding}" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- Shared selectable card gallery: add Classes="card-gallery" to any ListBox
             with a WrapPanel ItemsPanel to get a wrapping grid of hoverable/selectable
             cards. Reusable for instances now, and any future pickers (modpacks, servers). -->
        <Style Selector="ListBox.card-gallery">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.card-gallery ListBoxItem">
            <Setter Property="Background" Value="{StaticResource Surface0Brush}" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Surface2Brush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.card-gallery ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
        </Style>
        <Style Selector="ListBox.card-gallery ListBoxItem:selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentGreenBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Shared button baseline: every Button gets this look by default (rounded,
             dark, theme-consistent) instead of raw Fluent chrome. Buttons that need
             their own full look (e.g. MainWindow's "nav-btn") set every property
             themselves at a more specific selector and are unaffected. -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Surface1Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="{StaticResource ChipRadius}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- Shared primary action button (e.g. "Launch"). One definition, any page's
             main call-to-action reuses it instead of repeating inline styling. -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CrustBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Small round icon button (e.g. the card "edit" pencil). -->
        <Style Selector="Button.icon-circle">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Slide-down + fade entrance for flyout content. Add Classes="flyout-content"
             to a Flyout's root panel; code-behind (see HomeView/LibraryView .axaml.cs)
             toggles "open" on that SAME control via Flyout.Opened/Closed. Unlike
             FlyoutPresenterClasses (a one-shot copy onto a presenter that's recreated
             per open — toggling it after Opened never reaches what's on screen), the
             Flyout's Content is one persistent control for its whole lifetime, so
             mutating its Classes directly always live-updates. -->
        <Style Selector="StackPanel.flyout-content">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(-10px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.flyout-content.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0)" />
        </Style>
    </Application.Styles>
</Application>