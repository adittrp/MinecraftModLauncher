<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MinecraftModLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:internal="clr-namespace:Avalonia.Dialogs.Internal;assembly=Avalonia.Dialogs"
        xmlns:asyncImageLoader="using:AsyncImageLoader"
        xmlns:modrinthModels="clr-namespace:MinecraftModLauncher.Services"
        xmlns:modrinth="clr-namespace:MinecraftModLauncher.Models.Modrinth"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="1200"
        Height="800"
        x:Class="MinecraftModLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MinecraftModLauncher"
        x:Name="RootWindow">

	
	<!-- Variables to use throughout the styling (trying to avoid "magic numbers"...) -->
	<Window.Resources>
		<Thickness x:Key="DefaultMargin">20.0</Thickness>
		<CornerRadius x:Key="DefaultCornerRadius">10.0</CornerRadius>
		<Color x:Key="PrimaryBackground">#2b2d42</Color>
		<Color x:Key="SecondaryBackground">#392B42</Color>
		<Color x:Key="Foreground">#4e2c70</Color>
		<Color x:Key="Accent">#702b9e</Color>
	</Window.Resources>
	
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
	
	<!-- Parent stack panel -->
    <StackPanel Orientation="Horizontal" Spacing="10" Background="{StaticResource PrimaryBackground}">
	    <StackPanel Width="100">
		    
	    </StackPanel>
	    <StackPanel Margin="{StaticResource DefaultMargin}" Width='600' Background="{StaticResource PrimaryBackground}">
		    <TextBox Text="{Binding Greeting}"
		             HorizontalAlignment="Center"
		             VerticalAlignment="Center" />

			<Button Content="Sign in with Microsoft"
	            Command="{Binding signInCommand}" />

			<StackPanel Spacing="5" IsVisible="{Binding UserCode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
				<TextBlock Text="Go to:" />
				<TextBlock Text="{Binding VerificationUrl}" FontWeight="Bold" />
				<TextBlock Text="Enter this code:" />
				<TextBlock Text="{Binding UserCode}" FontSize="28" FontWeight="Bold" />
			</StackPanel>

			<Button Content="Launch Minecraft"
					Command="{Binding launchMinecraftCommand}" />
	        
		    <StackPanel Margin="{StaticResource DefaultMargin}" Spacing="5">
			    <Grid ColumnDefinitions="Auto,*,Auto">
				    <ComboBox Grid.Column="0"
				              ItemsSource="{Binding ModrinthSearch.ProjectTypes}"
				              SelectedItem="{Binding ModrinthSearch.SelectedProjectType}"
				              Margin="0,0,5,0"/>

				    <TextBox Grid.Column="1"
				             Text="{Binding ModrinthSearch.SearchQuery}"
				             PlaceholderText="Type to search..."/>

				    <Button Grid.Column="2"
				            Content="Search"
				            Command="{Binding ModrinthSearch.SearchCommand}"
				            Margin="5,0,0,0"/>
			    </Grid>

			    <TextBlock Text="{Binding ModrinthSearch.StatusMessage}" Opacity="0.7" FontSize="12"/>

			    <ListBox ItemsSource="{Binding ModrinthSearch.Results}" Height="600">
				    <ListBox.ItemTemplate>
					    <DataTemplate x:DataType="modrinth:ModrinthSearchHit">
						    <Border Padding="8" Margin="0,4">
							    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
								    <asyncImageLoader:AdvancedImage Grid.Column="0" Width="48" Height="48"
								                                    Source="{Binding IconUrl}"/>
								    <StackPanel Grid.Column="1" Spacing="2">
									    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
									    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" FontSize="12"/>
									    <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}" Opacity="0.6" FontSize="11"/>
								    </StackPanel>
								    <Button Grid.Column="2" Content="Install" VerticalAlignment="Center"
								            Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ModrinthSearch.InstallCommand}"
								            CommandParameter="{Binding}"/>
							    </Grid>
						    </Border>
					    </DataTemplate>
				    </ListBox.ItemTemplate>
			    </ListBox>
		    </StackPanel>
	    </StackPanel>
	    
	    <StackPanel Margin="{StaticResource DefaultMargin}" Width="400">
		    <TextBlock Margin="0 5" HorizontalAlignment="Center">Game logs:</TextBlock>
		    <Border Background="{StaticResource Foreground}" CornerRadius="{StaticResource DefaultCornerRadius}" Padding="6" ClipToBounds="True">
			    <ListBox x:Name="GameLogs" Height="700" ItemsSource="{Binding GameLogs}" Background="{StaticResource SecondaryBackground}" CornerRadius="{StaticResource DefaultCornerRadius}">
				    <ListBox.Styles>
					    <Style Selector="ListBoxItem">
						    <Setter Property="Margin" Value="0,2" />
						    <Setter Property="Padding" Value="4,2" />
					    </Style>
				    </ListBox.Styles>
				    <ListBox.ItemTemplate>
					    <DataTemplate>
						    <TextBlock Text="{Binding}" 
						               TextWrapping="Wrap" />
					    </DataTemplate>
					</ListBox.ItemTemplate>
			    </ListBox>
		    </Border>
	    </StackPanel>
    </StackPanel>
</Window>
