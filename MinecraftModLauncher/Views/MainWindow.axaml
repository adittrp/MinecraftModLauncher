<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MinecraftModLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        x:Class="MinecraftModLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MinecraftModLauncher"
        Background="{StaticResource CrustBrush}">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Window.Styles>
		<!-- Sidebar nav button -->
		<Style Selector="Button.nav-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Padding" Value="18,14" />
			<Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Surface0Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="Button.nav-btn.active">
			<Setter Property="Background" Value="{StaticResource Surface0Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Button.nav-btn.active /template/ ContentPresenter">
			<Setter Property="Background" Value="{StaticResource Surface0Brush}" />
			<Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="220,*">

		<!-- Side bar -->
		<Border Grid.Column="0" Background="{StaticResource MantleBrush}" Padding="12">
			<DockPanel>

				<!-- Branding -->
				<StackPanel DockPanel.Dock="Top" Margin="8,12,8,28">
					<TextBlock Text="MC Launcher" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
					<TextBlock Text="v1.0.0" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
				</StackPanel>

				<!-- Section label -->
				<TextBlock DockPanel.Dock="Top" Text="NAVIGATION"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}"
                           LetterSpacing="1.5" Margin="8,0,0,10" />

				<!-- Bottom account status -->
				<StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,4">
					<Border Height="1" Background="{StaticResource Surface0Brush}"
                            Margin="0,0,0,12" />
					<TextBlock Text="{Binding Account.Username,
                                   FallbackValue='Not signed in',
                                   TargetNullValue='Not signed in'}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" />
				</StackPanel>

				<!-- Nav buttons -->
				<StackPanel Spacing="4">
					<Button Classes="nav-btn"
                            Classes.active="{Binding IsHome}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Home">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🏠" FontSize="15"
                                       VerticalAlignment="Center" />
							<TextBlock Text="Home" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="nav-btn"
                            Classes.active="{Binding IsLibrary}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Library">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="📦" FontSize="15"
                                       VerticalAlignment="Center" />
							<TextBlock Text="Library" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="nav-btn"
                            Classes.active="{Binding IsConsole}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Console">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="🖥️" FontSize="15"
                                       VerticalAlignment="Center" />
							<TextBlock Text="Console" VerticalAlignment="Center" />
						</StackPanel>
					</Button>

					<Button Classes="nav-btn"
                            Classes.active="{Binding IsSettings}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="⚙️" FontSize="15"
                                       VerticalAlignment="Center" />
							<TextBlock Text="Settings" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</StackPanel>

			</DockPanel>
		</Border>

		<!-- Main Content -->
		<Border Grid.Column="1" Background="{StaticResource BaseBrush}">
			<ContentControl Content="{Binding CurrentPage}" />
		</Border>

	</Grid>
</Window>
